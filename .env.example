# Node 版（npm start）的环境变量。
# 复制成 .env，改完重启生效。
#
# 部署 Cloudflare Workers 时不要用这个文件：
#   - 变量写在 wrangler.toml 的 [vars]
#   - 密钥用 npx wrangler secret put ADMIN_PASSWORD / SESSION_SECRET
#   - 本地开发用 .dev.vars（见 .dev.vars.example）

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 【上线必填】二维码里写的固定域名。不填就按访问时的 Host 动态生成，
# 换域名后已打印的贴纸全部失效，所以正式使用一定要固定下来。
# 请求的 Host 与这里的域名一致时，会话 Cookie 会按这里的协议决定要不要带 Secure。
PUBLIC_BASE_URL=http://localhost:3000

# 车主后台密码。不设置则首次启动自动生成并打印在日志里。
# 设置后每次启动都会以它为准（改密码就改这里再重启）。
ADMIN_PASSWORD=

# 会话签名密钥。不设置则首次启动随机生成并写入数据库。
# 多实例部署时必须显式设置成同一个值。
SESSION_SECRET=

# 数据库与 WAL 文件所在目录
DATA_DIR=./data

# 页面时间显示用的时区偏移（小时），默认东八区
TZ_OFFSET_HOURS=8

# 部署在 Nginx / 云负载均衡后面时设为 1，
# 才会信任 X-Forwarded-For 与 X-Forwarded-Proto。
# TLS 由反向代理终止时同样要设为 1，否则会话 Cookie 不会带 Secure（也能用，但弱一些）。
TRUST_PROXY=0
